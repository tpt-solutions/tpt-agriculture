# ─── Supabase ────────────────────────────────────────────────────────────────
# From: Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Database ────────────────────────────────────────────────────────────────
# From: Supabase project → Settings → Database → Connection pooling (Transaction mode)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# From: Supabase project → Settings → Database → Direct connection
DIRECT_URL=postgresql://postgres.your-project:password@aws-0-region.supabase.com:5432/postgres

# ─── Stripe ──────────────────────────────────────────────────────────────────
# From: Stripe dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# From: Stripe dashboard → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create these in the Stripe dashboard
# Annual subscription prices (recurring, billed yearly)
STRIPE_PRICE_HORTICULTURE=price_...
STRIPE_PRICE_LIVESTOCK=price_...
STRIPE_PRICE_FULL=price_...

# Per-hectare and per-m² add-on prices (recurring, billed yearly)
STRIPE_PRICE_PER_HA=price_...
STRIPE_PRICE_PER_SQM_MICROGREENS=price_...
STRIPE_PRICE_PER_SQM_AQUAPONICS=price_...
STRIPE_PRICE_PER_SQM_PROTECTED_CROPPING=price_...

# One-time setup fee (in cents, e.g. 49900 = $499.00)
STRIPE_SETUP_FEE_CENTS=49900

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

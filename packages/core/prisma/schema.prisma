generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Identity ─────────────────────────────────────────────────────────────────
// Supabase Auth owns auth.users. Profile mirrors it for app data.

model Profile {
  id        String   @id // = Supabase auth.users.id (UUID)
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenants TenantUser[]

  @@index([email])
}

// ─── Tenant ───────────────────────────────────────────────────────────────────

model Tenant {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  countryProfile String   @default("nz")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users         TenantUser[]
  subscriptions Subscription[]

  @@index([slug])
}

model TenantUser {
  id        String     @id @default(cuid())
  tenantId  String
  profileId String
  role      TenantRole @default(MEMBER)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([tenantId, profileId])
  @@index([tenantId])
  @@index([profileId])
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
  READONLY
}

// ─── Subscriptions ────────────────────────────────────────────────────────────
// Access is gated entirely by Subscription.status + BundleTier.
// BUNDLE_MODULES config maps BundleTier → moduleId[] at runtime — no join table needed.

enum BundleTier {
  HORTICULTURE
  LIVESTOCK
  FULL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  UNPAID
}

model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String
  stripeSubscriptionId String             @unique
  bundleTier           BundleTier
  status               SubscriptionStatus @default(TRIALING)

  // Outdoor billing unit (null for indoor-only subscriptions)
  hectares Int?

  // Indoor billing units — different m² per module type at different $/m² rates.
  // Shape: { "microgreens": 50, "aquaponics": 200, "protected-cropping": 300 }
  indoorSqm Json?

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime // expiry = loss of access (standard SaaS)
  trialEnd           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([stripeSubscriptionId])
}

// ─── Livestock: Dairy Cattle ─────────────────────────────────────────────────────
// Individual cow records, milk production, SCC, drying off

model DairyCow {
  id              String   @id @default(cuid())
  tenantId        String
  animalId        String   // farm tag / eartag number
  breed           String?
  dateOfBirth     DateTime?
  sex             String   @default("FEMALE") // FEMALE, MALE
  currentStatus   String   @default("LACTATING") // LACTATING, DRY, SOLD, DECEASED
  calvingCount    Int      @default(0)
  lastCalvingDate DateTime?
  sire            String?
  dam             String?

  milkRecords  DairyMilkRecord[]
  healthEvents DairyHealthEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, animalId])
}

model DairyMilkRecord {
  id         String   @id @default(cuid())
  cowId      String
  date       DateTime
  liters     Float
  fatPct     Float?
  proteinPct Float?
  scc        Int?     // Somatic Cell Count (cells/mL)
  comments   String?

  cow DairyCow @relation(fields: [cowId], references: [id], onDelete: Cascade)

  @@index([cowId, date])
}

model DairyHealthEvent {
  id          String   @id @default(cuid())
  cowId       String
  date        DateTime
  eventType   String   // DryingOff, MastitisTreatment, Vaccination, VetVisit, Other
  description String
  withdrawn    Boolean  @default(false) // milk/food withholding
  withdrawnUntil DateTime?

  cow DairyCow @relation(fields: [cowId], references: [id], onDelete: Cascade)

  @@index([cowId, date])
}

// ─── Livestock: Beef Cattle ───────────────────────────────────────────────────────
// Mob tracking, weight gain records, drafting targets

model BeefMob {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  breed       String?
  headCount   Int
  location    String?  // paddock or yard
  targetWeightKg Float?
  notes       String?

  weightRecords BeefWeightRecord[]
  draftings     BeefDrafting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model BeefWeightRecord {
  id      String   @id @default(cuid())
  mobId   String
  date    DateTime
  avgWeightKg Float
  sampleCount Int?
  notes   String?

  mob BeefMob @relation(fields: [mobId], references: [id], onDelete: Cascade)

  @@index([mobId, date])
}

model BeefDrafting {
  id          String   @id @default(cuid())
  mobId       String
  date        DateTime
  headCount   Int
  avgWeightKg Float
  destination String   // Finished, Store, Cull, Sold
  notes       String?

  mob BeefMob @relation(fields: [mobId], references: [id], onDelete: Cascade)

  @@index([mobId, date])
}

// ─── Livestock: Sheep ─────────────────────────────────────────────────────────────
// Flock records, lambing %, drenching, shearing, wool

model SheepFlock {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  breed       String?
  headCount   Int
  notes       String?

  lambingRecords   SheepLambing[]
  drenchingRecords SheepDrenching[]
  shearingRecords  SheepShearing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model SheepLambing {
  id             String   @id @default(cuid())
  flockId        String
  season         String   // e.g. "2025-26"
  ewesLambed     Int
  lambsBorn      Int
  lambsAlive     Int
  lambingPct     Float?   // calculated: (lambsAlive / ewesLambed) * 100
  date           DateTime
  notes          String?

  flock SheepFlock @relation(fields: [flockId], references: [id], onDelete: Cascade)

  @@index([flockId])
}

model SheepDrenching {
  id            String   @id @default(cuid())
  flockId       String
  date          DateTime
  product       String
  doseMl        Float?
  headCount     Int
  withholdingMeat  Int?   // days
  notes         String?

  flock SheepFlock @relation(fields: [flockId], references: [id], onDelete: Cascade)

  @@index([flockId, date])
}

model SheepShearing {
  id         String   @id @default(cuid())
  flockId    String
  date       DateTime
  headCount  Int
  woolKg     Float
  woolGrade  String?  // e.g. Fine, Medium, Strong
  buyer      String?
  pricePerKg Float?
  notes      String?

  flock SheepFlock @relation(fields: [flockId], references: [id], onDelete: Cascade)

  @@index([flockId, date])
}

// ─── Livestock: Goats ─────────────────────────────────────────────────────────────
// Herd, milking records, fibre tracking

model GoatHerd {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  breed     String?
  headCount Int
  type      String   @default("DAIRY") // DAIRY, FIBRE, MEAT, DUAL
  notes     String?

  milkRecords   GoatMilkRecord[]
  fibreRecords  GoatFibreRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model GoatMilkRecord {
  id        String   @id @default(cuid())
  herdId    String
  date      DateTime
  liters    Float
  butterfat Float?
  protein   Float?
  comments  String?

  herd GoatHerd @relation(fields: [herdId], references: [id], onDelete: Cascade)

  @@index([herdId, date])
}

model GoatFibreRecord {
  id       String   @id @default(cuid())
  herdId   String
  date     DateTime
  fibreKg  Float
  fibreType String? // Mohair, Cashmere, Cashgora
  grade    String?
  buyer    String?
  pricePerKg Float?
  notes    String?

  herd GoatHerd @relation(fields: [herdId], references: [id], onDelete: Cascade)

  @@index([herdId, date])
}

// ─── Livestock: Deer ──────────────────────────────────────────────────────────────
// Velvet records, stag/hind management, venison

model DeerHerd {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  species    String?  // Red, Fallow, Wapiti, etc.
  headCount  Int
  notes      String?

  velvetRecords  DeerVelvetRecord[]
  venisonRecords DeerVenisonRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model DeerVelvetRecord {
  id          String   @id @default(cuid())
  herdId      String
  stagId      String?  // individual stag identifier
  harvestDate DateTime
  velvetKg    Float
  grade       String?
  buyer       String?
  pricePerKg  Float?
  notes       String?

  herd DeerHerd @relation(fields: [herdId], references: [id], onDelete: Cascade)

  @@index([herdId, harvestDate])
}

model DeerVenisonRecord {
  id          String   @id @default(cuid())
  herdId      String
  date        DateTime
  headCount   Int
  carcassKg   Float
  grade       String?
  buyer       String?
  pricePerKg  Float?
  notes       String?

  herd DeerHerd @relation(fields: [herdId], references: [id], onDelete: Cascade)

  @@index([herdId, date])
}

// ─── Livestock: Pigs ──────────────────────────────────────────────────────────────
// Sow records, litter tracking, feed conversion

model PigSow {
  id         String   @id @default(cuid())
  tenantId   String
  animalId   String   // farm tag / eartag
  breed      String?
  dateOfBirth DateTime?
  parityCount Int     @default(0)
  status     String   @default("ACTIVE") // ACTIVE, DRY, SOLD, DECEASED
  sire       String?

  litters PigLitter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, animalId])
}

model PigLitter {
  id            String   @id @default(cuid())
  sowId         String
  farrowDate    DateTime
  pigletsBorn   Int
  pigletsAlive  Int
  pigletsWeaned Int?
  weanDate      DateTime?
  notes         String?

  sow PigSow @relation(fields: [sowId], references: [id], onDelete: Cascade)

  @@index([sowId, farrowDate])
}

model PigFeedRecord {
  id           String   @id @default(cuid())
  tenantId     String
  date         DateTime
  groupName    String   // e.g. "Growers", "Finishers", "Sows"
  headCount    Int
  feedType     String
  feedKg       Float
  costPerKg    Float?
  notes        String?

  @@index([tenantId, date])
}

// ─── Livestock: Poultry ───────────────────────────────────────────────────────────
// Flock batches, egg production, mortality log

model PoultryFlock {
  id          String   @id @default(cuid())
  tenantId    String
  batchName   String
  species     String   // Chicken, Duck, Turkey, etc.
  breed       String?
  birdCount   Int
  housedDate  DateTime
  house       String?  // shed / barn name
  purpose     String   // MEAT, EGGS, DUAL
  status      String   @default("ACTIVE") // ACTIVE, PROCESSED, DEPLETED
  notes       String?

  eggRecords     PoultryEggRecord[]
  mortalityLogs  PoultryMortality[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model PoultryEggRecord {
  id       String   @id @default(cuid())
  flockId  String
  date     DateTime
  eggCount Int
  grade    String?  // e.g. "Jumbo", "Large", "Medium"
  cracked  Int      @default(0)
  comments String?

  flock PoultryFlock @relation(fields: [flockId], references: [id], onDelete: Cascade)

  @@index([flockId, date])
}

model PoultryMortality {
  id       String   @id @default(cuid())
  flockId  String
  date     DateTime
  count    Int
  cause    String?  // Disease, Injury, Unknown, Cull
  notes    String?

  flock PoultryFlock @relation(fields: [flockId], references: [id], onDelete: Cascade)

  @@index([flockId, date])
}

// ─── Livestock: Bees ──────────────────────────────────────────────────────────────
// Hive inspections, honey harvest, mite treatment, queen records

model BeeHive {
  id          String   @id @default(cuid())
  tenantId    String
  hiveName    String
  hiveType    String?  // Langstroth, Top-bar, Flow, Warre
  location    String?
  queenAge    Int?     // months
  queenColor  String?  // marking dot colour for year
  origin      String?  // Nuc, Package, Swarm
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, LOST, SPLIT
  notes       String?

  inspections  BeeInspection[]
  honeyHarvests BeeHoneyHarvest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model BeeInspection {
  id            String   @id @default(cuid())
  hiveId        String
  date          DateTime
  temperament   String?  // Calm, Nervous, Aggressive
  queenSeen     Boolean  @default(true)
  eggsPresent   Boolean  @default(true)
  broodPattern  String?  // Good, Patchy, Spotty
  miteCount     Int?     // Varroa mite count
  foodStores    String?  // Honey frames count
  diseaseSigns  String?
  action        String?  // e.g. "Added super", "Re-queened", "Treated"
  notes         String?

  hive BeeHive @relation(fields: [hiveId], references: [id], onDelete: Cascade)

  @@index([hiveId, date])
}

model BeeHoneyHarvest {
  id       String   @id @default(cuid())
  hiveId   String
  date     DateTime
  kg       Float
  type     String?  // Manuka, Clover, Mixed, etc.
  grade    String?
  buyer    String?
  pricePerKg Float?
  notes    String?

  hive BeeHive @relation(fields: [hiveId], references: [id], onDelete: Cascade)

  @@index([hiveId, date])
}

// ─── Horticulture: Field Management ──────────────────────────────────────────────
// Farm → Field CRUD, soil types, irrigation zones, plot grid

model Field {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  areaHa      Float
  soilType    String?
  irrigationZone String?
  coordinates Json?    // GeoJSON polygon
  notes       String?

  plots       Plot[]
  cropPlans   CropPlan[]
  harvestBatches HarvestBatch[]
  sprayEvents SprayEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Plot {
  id       String  @id @default(cuid())
  fieldId  String
  name     String
  row      Int?
  col      Int?    // grid position
  areaSqm  Float?
  notes    String?

  field           Field           @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  harvestRecords  HarvestRecord[]

  @@index([fieldId])
}

// ─── Horticulture: Crop Planning ──────────────────────────────────────────────────
// Planting calendars, succession schedules, task list

model CropPlan {
  id                  String    @id @default(cuid())
  tenantId            String
  fieldId             String?
  cropVariety         String
  plannedPlantDate    DateTime
  plannedHarvestDate  DateTime?
  actualPlantDate     DateTime?
  actualHarvestDate   DateTime?
  status              String    @default("PLANNED") // PLANNED, ACTIVE, HARVESTED, ABANDONED
  notes               String?

  field        Field?        @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  plantingTasks PlantingTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([fieldId])
}

model PlantingTask {
  id            String    @id @default(cuid())
  cropPlanId    String
  taskType      String    // Sow, Transplant, Fertilise, Irrigate, Harvest, Other
  dueDate       DateTime
  completedDate DateTime?
  assignedTo    String?
  notes         String?

  cropPlan CropPlan @relation(fields: [cropPlanId], references: [id], onDelete: Cascade)

  @@index([cropPlanId, dueDate])
}

// ─── Horticulture: Harvest Tracking ───────────────────────────────────────────────
// Yield entry, batch records, grade tracking

model HarvestBatch {
  id           String   @id @default(cuid())
  tenantId     String
  fieldId      String?
  cropVariety  String
  harvestDate  DateTime
  totalYieldKg Float
  gradeBreakdown Json?  // { "Grade1": 120, "Grade2": 30, "Cull": 5 }
  lotNumber    String?
  buyer        String?
  pricePerKg   Float?
  notes        String?

  field   Field?          @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  records HarvestRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([fieldId, harvestDate])
}

model HarvestRecord {
  id        String  @id @default(cuid())
  batchId   String
  plotId    String?
  yieldKg   Float
  grade     String?
  notes     String?

  batch HarvestBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  plot  Plot?        @relation(fields: [plotId], references: [id], onDelete: SetNull)

  @@index([batchId])
}

// ─── Horticulture: Pest & Spray Log ───────────────────────────────────────────────
// Chemical register, spray events, withholding periods

model Chemical {
  id                    String  @id @default(cuid())
  tenantId              String
  name                  String
  activeIngredient      String?
  registrationNo        String?
  withholdingPeriodDays Int?
  safetyNotes           String?
  hazardClass           String?

  sprayEvents SprayEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model SprayEvent {
  id                 String   @id @default(cuid())
  tenantId           String
  fieldId            String?
  chemicalId         String?
  applicationDate    DateTime
  ratePerHa          Float?
  totalVolumeLitres  Float?
  operator           String?
  weatherConditions  String?
  windSpeedKph       Float?
  tempC              Float?
  withholdingEndDate DateTime?
  notes              String?

  field    Field?    @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  chemical Chemical? @relation(fields: [chemicalId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId, applicationDate])
  @@index([fieldId])
}

// ─── Horticulture: Viticulture ────────────────────────────────────────────────────
// Block/row management, canopy notes, brix tracking, vintage records

model VitBlock {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  variety     String
  areaHa      Float
  rowCount    Int?
  rootstock   String?
  yearPlanted Int?
  trellisSystem String?
  notes       String?

  vintageRecords VintageRecord[]
  canopyNotes    CanopyNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model VintageRecord {
  id              String   @id @default(cuid())
  blockId         String
  year            Int
  brixAtHarvest   Float?
  phAtHarvest     Float?
  taAtHarvest     Float?   // titratable acidity g/L
  yieldKg         Float?
  harvestDate     DateTime?
  winemaker       String?
  notes           String?

  block VitBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, year])
  @@index([blockId])
}

model CanopyNote {
  id           String   @id @default(cuid())
  blockId      String
  date         DateTime
  shootLengthCm Float?
  lateralGrowth String?
  leafAreaIndex Float?
  observations String?
  photos       Json?    // array of Supabase Storage paths

  block VitBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId, date])
}

// ─── Horticulture: Orchard ────────────────────────────────────────────────────────
// Tree inventory, spray programs, harvest bins

model OrchardBlock {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  species     String   // Apple, Pear, Cherry, Kiwifruit, etc.
  variety     String?
  areaHa      Float?
  yearPlanted Int?
  rootstock   String?
  pollinatorVariety String?
  notes       String?

  treeInventory   TreeInventory[]
  harvestBins     OrchardHarvestBin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model TreeInventory {
  id         String  @id @default(cuid())
  blockId    String
  treeCount  Int
  treeSpacingM Float?
  rowSpacingM  Float?
  trainingSystem String?
  notes      String?

  block OrchardBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId])
}

model OrchardHarvestBin {
  id          String   @id @default(cuid())
  blockId     String
  harvestDate DateTime
  binCount    Int
  weightKg    Float?
  grade       String?
  coolstoreId String?
  notes       String?

  block OrchardBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId, harvestDate])
}

// ─── Horticulture: Vegetables ─────────────────────────────────────────────────────
// Bed/row tracking, transplant records, succession planting

model VegBed {
  id             String  @id @default(cuid())
  tenantId       String
  name           String
  lengthM        Float?
  widthM         Float?
  indoor         Boolean @default(false)
  soilMix        String?
  irrigationType String?
  notes          String?

  successions VegSuccession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model VegSuccession {
  id                  String    @id @default(cuid())
  bedId               String
  cropVariety         String
  plantDate           DateTime
  transplantDate      DateTime?
  expectedHarvestDate DateTime?
  actualHarvestDate   DateTime?
  yieldKg             Float?
  seedSource          String?
  notes               String?

  bed VegBed @relation(fields: [bedId], references: [id], onDelete: Cascade)

  @@index([bedId, plantDate])
}

// ─── Horticulture: Microgreens ────────────────────────────────────────────────────
// Tray tracking, 7–14 day cycles, yield and revenue per batch (billed per m²)

model MicrogreenBatch {
  id                  String    @id @default(cuid())
  tenantId            String
  variety             String
  substrate           String?   // Coco coir, Peat, Jute, etc.
  trayCount           Int
  traySizeCm          String?   // e.g. "20x40"
  seedingDate         DateTime
  expectedHarvestDate DateTime?
  actualHarvestDate   DateTime?
  yieldGrams          Float?
  revenueNzd          Float?
  buyer               String?
  notes               String?

  trays MicrogreenTray[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, seedingDate])
}

model MicrogreenTray {
  id          String  @id @default(cuid())
  batchId     String
  trayNumber  Int
  yieldGrams  Float?
  notes       String?

  batch MicrogreenBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

// ─── Horticulture: Protected Cropping ─────────────────────────────────────────────
// Greenhouse/tunnel structure records, climate log, fertigation (billed per m²)

model Structure {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  type        String   // GREENHOUSE, POLYTUNNEL, SHADE_HOUSE, SCREENHOUSE
  areaSqm     Float
  yearBuilt   Int?
  roofMaterial String?
  heatingSystem String?
  notes       String?

  climateLogs       ClimateLog[]
  fertigationEvents FertigationEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model ClimateLog {
  id          String   @id @default(cuid())
  structureId String
  date        DateTime
  tempMinC    Float?
  tempMaxC    Float?
  humidityPct Float?
  co2Ppm      Int?
  lightLux    Int?
  notes       String?

  structure Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([structureId, date])
}

model FertigationEvent {
  id             String   @id @default(cuid())
  structureId    String
  date           DateTime
  ec             Float?   // electrical conductivity mS/cm
  ph             Float?
  nutrients      Json?    // { "N": 150, "P": 50, "K": 200 } ppm
  volumeLitres   Float?
  irrigationMins Int?
  notes          String?

  structure Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([structureId, date])
}

// ─── Horticulture: Aquaponics ─────────────────────────────────────────────────────
// Fish stock + grow beds, water quality, feeding schedules, plant bed yields (billed per m²)

model AquaSystem {
  id               String  @id @default(cuid())
  tenantId         String
  name             String
  systemType       String  // NFT, DWC, Media_Bed, Raft, Hybrid
  fishTankLitres   Float?
  growBedSqm       Float?
  pumpFlowLph      Float?
  notes            String?

  fishStocks       FishStock[]
  waterQualityLogs WaterQualityLog[]
  feedingEvents    AquaFeedingEvent[]
  plantBedYields   AquaPlantYield[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model FishStock {
  id             String   @id @default(cuid())
  systemId       String
  species        String   // Tilapia, Trout, Perch, Barramundi, etc.
  stockCount     Int
  averageWeightG Float?
  stockDate      DateTime
  source         String?
  notes          String?

  system AquaSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@index([systemId, stockDate])
}

model WaterQualityLog {
  id          String   @id @default(cuid())
  systemId    String
  date        DateTime
  ph          Float?
  ammoniaMgl  Float?
  nitriteMgl  Float?
  nitrateMgl  Float?
  doMgl       Float?   // dissolved oxygen
  tempC       Float?
  notes       String?

  system AquaSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@index([systemId, date])
}

model AquaFeedingEvent {
  id        String   @id @default(cuid())
  systemId  String
  date      DateTime
  feedType  String?
  amountG   Float
  notes     String?

  system AquaSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@index([systemId, date])
}

model AquaPlantYield {
  id          String   @id @default(cuid())
  systemId    String
  date        DateTime
  cropVariety String
  yieldGrams  Float
  bed         String?  // bed identifier within the system
  notes       String?

  system AquaSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@index([systemId, date])
}

// ─── Livestock: Pasture ───────────────────────────────────────────────────────────
// Paddock rotation, cover measurement, feed budget

model Paddock {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  areaHa     Float
  soilType   String?
  grassType  String?
  notes      String?

  rotationRecords PaddockRotation[]
  coverRecords    PastureCoverRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model PaddockRotation {
  id         String   @id @default(cuid())
  paddockId  String
  startDate  DateTime
  endDate    DateTime?
  stockType  String?  // Cattle, Sheep, Goats, Deer, etc.
  headCount  Int?
  comments   String?

  paddock Paddock @relation(fields: [paddockId], references: [id], onDelete: Cascade)

  @@index([paddockId])
}

model PastureCoverRecord {
  id         String   @id @default(cuid())
  paddockId  String
  date       DateTime
  coverKgHa  Float
  method     String?  // Rising Plate Meter, C-Dax, Visual, Satellite
  growthRate Float?   // kg DM/ha/day
  notes      String?

  paddock Paddock @relation(fields: [paddockId], references: [id], onDelete: Cascade)

  @@index([paddockId, date])
}
